---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="That page does not exist on shahmohammadi.dev."
>
  <section class="mx-auto max-w-page px-6 py-32">
    <p class="text-meta text-muted tabular-nums">404</p>
    <h1 class="mt-2 text-display">Page not found</h1>
    <p class="mt-5 text-lead text-muted">
      That URL does not exist. It may have moved, or it may never have.
    </p>
    <a
      href="/"
      class="mt-9 inline-block rounded-full border border-border px-5 py-2.5 text-body font-medium transition-colors hover:border-accent hover:text-accent"
    >
      Back to the homepage
    </a>
  </section>
</BaseLayout>
