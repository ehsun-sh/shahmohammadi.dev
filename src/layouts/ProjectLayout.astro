---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Section from '../components/Section.astro';
import { resolveProjectImage } from '../lib/projectImages';
import { STATUS_LABEL, type ProjectPage } from '../lib/projects';

/**
 * The one template every project page renders through.
 *
 * There is no per-project design and there must never be one: a future project
 * is a markdown file in `src/content/projects/`, and this file decides what it
 * looks like. Anything that would tempt you to special-case a project belongs
 * in the schema as a field instead.
 *
 * Reading order is deliberate — title, one-sentence summary, picture, spec
 * table, then the long form. A technical reader decides whether to keep going
 * somewhere in the first three, and the spec table is what they check before
 * committing to the prose. The reasoning is the payoff, not the hook.
 */

interface Props {
  page: ProjectPage;
  /** Neighbours in cv.json order, for the footer pager. Null at the ends. */
  prev: ProjectPage | null;
  next: ProjectPage | null;
}

const { page, prev, next } = Astro.props;
const { cv: project, entry } = page;
const {
  role,
  context,
  tools,
  team,
  licence,
  status,
  cover,
  coverAlt,
  gallery,
  specs,
  links,
} = entry.data;

// A dedicated cover is better cropped for the full measure, but demanding two
// pictures per project is how projects end up with none. The thumbnail is
// exported at 1600px, which covers an 896px column, so it stands in.
const image = cover ?? resolveProjectImage(project.image, project.name);
const imageAlt = cover ? (coverAlt ?? '') : project.imageAlt;

/**
 * The fixed table. Same rows, same order, on every project page.
 *
 * Built here rather than in each file's frontmatter, which is the point: a
 * table assembled from free-form label/value pairs is only as consistent as
 * whoever last edited it, and these are the questions asked of every project
 * regardless of what it is. Two of them are not in the frontmatter at all —
 * `year` comes from cv.json because the résumé prints it, and `status` had a
 * field already — so nothing is written down twice to appear here.
 *
 * Role leads because "what did you actually do" is the first thing a technical
 * reader wants settled, and Team is directly under it because it is the same
 * question from the other side. Only Team and Licence are optional, and an
 * absent one drops its row rather than printing an empty cell: a blank value
 * reads as an oversight, where a missing row reads as not applicable.
 */
const rows = [
  { label: 'Role', value: role },
  ...(team ? [{ label: 'Team', value: team }] : []),
  { label: 'Context', value: context },
  { label: 'Year', value: project.year },
  { label: 'Status', value: STATUS_LABEL[status] },
  { label: 'Tools', value: tools },
  ...(licence ? [{ label: 'Licence', value: licence }] : []),
];
---

<BaseLayout
  title={project.name}
  description={project.summary}
  ogImage={`/og/projects/${page.slug}.png`}
>
  <div class="mx-auto max-w-page space-y-5 px-6 pt-6 pb-8">
    {
      page.draft && (
        /* Only ever visible in `npm run dev` — the build drops draft pages
           entirely, so this banner cannot reach a visitor. */
        <p class="rounded-card border border-dashed border-border bg-surface px-4 py-2.5 text-meta text-muted">
          Draft — excluded from the build. Set <code class="font-mono">draft:
          false</code> in the frontmatter to publish.
        </p>
      )
    }

    {/* On the ground rather than in a card: it is a way out of the page, not
        part of it, and giving it a plate would have made it the first thing
        the page appears to be about. */}
    <nav aria-label="Breadcrumb">
      <a
        href="/projects/"
        class="inline-flex items-center gap-1.5 text-meta text-muted transition-colors hover:text-text"
      >
        <span aria-hidden="true">&larr;</span>
        All projects
      </a>
    </nav>

    <header class="card sm:p-8">
      {/* Heading size, not display — half of what it was, and it lands on a
          role that already exists rather than on a new number. `display` is a
          clamp from 28 to 36px, so half of it would be 14 to 18: the top of
          that range IS `text-heading`, and the bottom is body size, which is
          too small for the title of a page. One role, flat at 18/700.

          The same call `ProfileCard` makes for the landing page's <h1>: this
          is a document with a title, not a masthead. Hierarchy here is carried
          by weight — 700 against the summary's 400 — which is how every
          section card on the site already separates its title from its
          content. */}
      {/* Two lines: the name, then the phrase that finishes it for someone who
          has never heard of it. The second is inside the <h1> as a block-level
          span rather than a <p> after it, so the accessible name of the heading
          is "Maiman Studio modular simulator for optical communication links" —
          which is what a screen reader user needs from a page title — while the
          two still set as separate lines with their own size and colour.
          Rendered only when there is one: a name that already describes itself
          would otherwise repeat. */}
      <h1 class="text-heading">
        {project.name}
        {/* An explicit space, and it is not decoration. The accessible name of
            a heading is its text content concatenated, and with a block-level
            span and no whitespace node between them it computed as "Maiman
            Studiomodular simulator…". The space renders as nothing, because the
            span is a block and starts its own line either way. */}
        {' '}
        {
          project.tagline && (
            <span class="mt-1 block text-meta font-normal text-muted">
              {project.tagline}
            </span>
          )
        }
      </h1>
      {/* Body, and in ink. It was lead-size and muted, which is the standfirst
          treatment `PageHeader` gives `/projects` and `/services` — right for
          a page that introduces a list, wrong for a page whose own subject
          starts one line later. At body size the muted grey would break the
          rule that only chrome is grey and body copy is ink, so it takes
          `--color-text` on the way down. Same size and colour the landing
          page's project rows give this exact sentence. */}
      <p class="prose-block mt-3">{project.summary}</p>
      {/* Year and status used to sit here as a meta line. They are rows in the
          table now, which begins immediately under this card — repeating them
          would be the same two facts twice within one screen, and the point of
          the table is that it is the one place every project answers the same
          questions. The tags stay: they are domain keywords for scanning, not
          an answer to any of those questions. */}
      {
        project.tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-1.5">
            {project.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )
      }

      {
        image ? (
        /* The cover is the largest thing above the fold on this page, so it is
           the LCP element — eager and high priority, unlike every other image
           on the site, which is lazy. */
        <Image
          src={image}
          alt={imageAlt}
          widths={[640, 896, 1792]}
          sizes="(min-width: 56rem) 896px, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="mt-7 w-full rounded-card border border-subtle object-cover"
          style="aspect-ratio: 16 / 10"
        />
      ) : (
        import.meta.env.DEV && (
          /* Dev only, unlike the dashed frame on the CV list, which ships.
             Size decides it: at 160px a placeholder is a design element that
             holds the row's shape, but at 896×560 it is a hole halfway down
             the page. A published project with no picture is better off going
             straight from the tags to the spec table.

             Kept visible while writing so the slot, its exact ratio and the
             filename it wants are all in front of you on the page itself. */
          <div
            class="mt-7 flex w-full flex-col items-center justify-center gap-1 rounded-card border border-dashed border-border bg-bg text-center"
            style="aspect-ratio: 16 / 10"
          >
            <p class="text-subhead text-muted">Cover image</p>
            <p class="text-meta text-muted">
              16:10 · 1600 × 1000 · set <code class="font-mono">image</code> on
              this project in <code class="font-mono">cv.json</code>
            </p>
            <p class="text-meta text-muted">
              Dev only — this frame is not in the build.
            </p>
          </div>
        )
      )
      }
    </header>

    <Section id="project-details" title="Project details">
      {/* A spec sheet is read down a column, not across a card. Hairline per
          row, label in the meta role, value in body — the same two roles the
          Skills list uses, so the two blocks look related.

          The rules are the soft grey: inside a card they divide rows of one
          table, and at --color-border a stack of them read as a stack of card
          edges.

          No `border-t`. `Section` already closes its heading with a full-width
          hairline, so a top border here drew a second one 20px under it and the
          table opened with a pair of rules. Every row keeps its `border-b`, so
          the section's own rule is the first row's top edge and the count comes
          out right. */}
      <dl>
        {rows.map((row) => (
          <div class="grid gap-1 border-b border-subtle py-3 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <dt class="text-meta text-muted">{row.label}</dt>
            <dd class="min-w-0">{row.value}</dd>
          </div>
        ))}
        {/* Written out rather than mapped with the rest, because these values
            are anchors and the others are strings. It is one row however many
            links there are — a project with a repo, a paper and a demo should
            not get three rows where every other project gets one. */}
        {
          links.length > 0 && (
            <div class="grid gap-1 border-b border-subtle py-3 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <dt class="text-meta text-muted">
                {links.length > 1 ? 'Links' : 'Link'}
              </dt>
              <dd class="flex min-w-0 flex-wrap gap-x-4 gap-y-1">
                {links.map((link) => (
                  <a
                    href={link.href}
                    rel="noopener"
                    class="text-accent transition-colors hover:underline"
                  >
                    {link.label}
                  </a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </Section>

    {
      specs.length > 0 && (
        /* The per-project engineering numbers, below the uniform table and
           only when there are any. Two projects are not expected to match
           here — a transceiver has a line rate and a relay has trip classes —
           which is exactly why this is the second table and not the first. */
        <Section id="specifications" title="Specifications">
          {/* No `border-t`, same as the table above — see the note there. */}
          <dl>
            {specs.map((row) => (
              <div class="grid gap-1 border-b border-subtle py-3 sm:grid-cols-[11rem_1fr] sm:gap-6">
                <dt class="text-meta text-muted">{row.label}</dt>
                <dd class="min-w-0">{row.value}</dd>
              </div>
            ))}
          </dl>
        </Section>
      )
    }

    {/* The write-up itself, on its own plate. Its headings arrive from markdown
        as bare tags, so `.prose-doc` styles them — onto the same six type
        roles, which is why an <h2> here matches a section title above it
        exactly, hairline included. */}
    <article class="card prose-doc sm:p-8">
      <slot />
    </article>

    {
      gallery.length > 0 && (
        /* After the write-up, not before it. The cover's job is to say what the
           thing is before anyone reads a word; these are evidence, and evidence
           is read after the argument it supports. A gallery above the prose
           would also push the first heading below the fold on a phone.

           One column, full measure. A two-up grid halves every picture to save
           scrolling, which is the wrong trade for a board photo or a scope
           capture — the detail IS the point, and a 430px-wide thermal image
           proves nothing. */
        <Section id="gallery" title="Gallery">
          <ul class="space-y-6">
            {gallery.map((item) => (
              <li>
                <figure>
                  {/* `widths` tops out at 1792 for the 896px column at 2x.
                      Loaded lazily, unlike the cover: everything here is below
                      the write-up and nobody sees it at first paint. */}
                  <Image
                    src={item.src}
                    alt={item.alt}
                    widths={[448, 896, 1792]}
                    sizes="(min-width: 48rem) 44rem, 100vw"
                    loading="lazy"
                    decoding="async"
                    class="w-full rounded-card border border-border"
                  />
                  {item.caption && (
                    /* Meta, muted, and that is one of the rare content
                       exceptions the colour rule allows: a caption is chrome
                       attached to a picture rather than body copy, the same
                       call the section note gets. */
                    <figcaption class="mt-2.5 text-meta text-muted">
                      {item.caption}
                    </figcaption>
                  )}
                </figure>
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    {
      (prev || next) && (
        <nav class="grid gap-5 sm:grid-cols-2" aria-label="More projects">
          {/* A plate each, at the same 20px gap as every other pair of plates
              on the page — the pager used to be a rule and two bare links, and
              a rule sitting on the tinted ground under a card had nothing to
              draw itself against.

              `col-start-2` keeps a lone "next" on the right where it belongs,
              rather than sliding into the empty first column.

              The aria-label is not decoration: the two spans run together in
              the accessible name as "PreviousOptical Transmitter System with
              WDM", because a block-level child does not insert a space. */}
          {prev && (
            <a
              href={`/projects/${prev.slug}/`}
              class="card group transition-colors hover:border-border"
              aria-label={`Previous project: ${prev.cv.name}`}
            >
              <span class="text-meta text-muted">Previous</span>
              <span class="mt-1 block text-subhead transition-colors group-hover:text-accent">
                {prev.cv.name}
              </span>
            </a>
          )}
          {next && (
            <a
              href={`/projects/${next.slug}/`}
              class="card group transition-colors hover:border-border sm:col-start-2 sm:text-right"
              aria-label={`Next project: ${next.cv.name}`}
            >
              <span class="text-meta text-muted">Next</span>
              <span class="mt-1 block text-subhead transition-colors group-hover:text-accent">
                {next.cv.name}
              </span>
            </a>
          )}
        </nav>
      )
    }
  </div>
</BaseLayout>
