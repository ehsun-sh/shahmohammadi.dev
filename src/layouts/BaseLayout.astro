---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { cv } from '../data/cv';

interface Props {
  title: string;
  description: string;
  /** Root-relative path to a social card. Built by `src/pages/og.png.ts`. */
  ogImage?: string;
  /**
   * Which container the page's content sits in, so the header and footer can
   * sit in the same one. `page` (48rem) is the reading column every ordinary
   * page uses; `wide` (71rem) is the landing page, which is a rail plus a main
   * column and is the only thing on the site that needs the extra width.
   *
   * Without this the bar would be 71rem everywhere and its logo would start
   * 184px to the left of the card underneath it on five pages out of six.
   */
  shell?: 'page' | 'wide';
  /**
   * Where "Skip to content" lands. The default is the whole `<main>`, which is
   * right until a page opens with something the visitor would want to skip —
   * the landing page's hero is 350vh of animation, and skipping to the top of
   * it skips nothing.
   */
  skipTo?: string;
}

const {
  title,
  description,
  ogImage = '/og.png',
  shell = 'page',
  skipTo = '#main',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle =
  title === cv.basics.name ? title : `${title} — ${cv.basics.name}`;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// Recruiters google you before they read you. This is what shows up.
// Placeholder profile URLs are filtered out — pointing sameAs at a 404 is worse
// than omitting the property.
const currentRole = cv.work.find((job) => job.endDate === null);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${cv.basics.url}/#person`,
  name: cv.basics.name,
  jobTitle: cv.basics.label,
  description: cv.basics.headline,
  url: cv.basics.url,
  image: new URL('/apple-touch-icon.png', Astro.site).href,
  email: `mailto:${cv.basics.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: cv.basics.location.city,
    addressCountry: cv.basics.location.countryCode,
  },
  sameAs: cv.basics.profiles
    .map((p) => p.url)
    .filter((url) => !url.includes('TODO')),
  knowsAbout: cv.skills.flatMap((group) => group.items),
  // Omitted rather than emitted empty when cv.json carries no languages —
  // `"knowsLanguage": []` is a claim to know none, not an absence of a claim.
  ...(cv.languages.length > 0 && {
    knowsLanguage: cv.languages.map((entry) => entry.language),
  }),
  alumniOf: cv.education.map((entry) => ({
    '@type': 'CollegeOrUniversity',
    name: entry.institution,
  })),
  award: cv.awards.map((entry) => entry.title),
  ...(currentRole && {
    worksFor: { '@type': 'Organization', name: currentRole.company },
  }),
  hasOccupation: {
    '@type': 'Occupation',
    name: cv.basics.label,
    occupationalCategory: '17-2072.00', // O*NET: Electronics Engineers
  },
};

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: { '@id': `${cv.basics.url}/#person` },
  url: canonical,
  name: fullTitle,
  description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* One multi-resolution .ico covers 16→256 for every desktop browser. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* The typeface is the largest render-blocking dependency on every page, and
        it is referenced from a stylesheet the browser has to download and parse
        before it can discover it. Preloading from the HTML starts the fetch in
        the same round trip as the CSS. Only the upright face — italic is used
        by markdown emphasis and nowhere near the fold.

        The path is fixed rather than content-hashed, which is the reason the
        font is copied into public/ instead of bundled. See scripts/copy-fonts.mjs. */}
    <link
      rel="preload"
      href="/fonts/noto-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta
      name="theme-color"
      content="#f4f5f9"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#000000"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="author" content={cv.basics.name} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={cv.basics.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${cv.basics.name} — ${cv.basics.label}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Runs before first paint so the theme never flashes. `is:inline` keeps
        it out of the bundle — it must not be deferred. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          /* private mode / storage blocked — CSS media query handles it */
        }
      })();
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify([personSchema, profilePageSchema])}
    />

    <Analytics />
  </head>

  <body class="min-h-dvh flex flex-col">
    <a class="skip-link" href={skipTo}>Skip to content</a>
    <Navigation shell={shell} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer shell={shell} />
  </body>
</html>
