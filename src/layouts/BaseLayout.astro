---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { cv } from '../data/cv';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative path to a social card. Generated in Phase 2. */
  ogImage?: string;
  /** Set on long-form pages to constrain the reading measure. */
  prose?: boolean;
}

const { title, description, ogImage } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle =
  title === cv.basics.name ? title : `${title} — ${cv.basics.name}`;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;

// Recruiters google you before they read you. This is what shows up.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: cv.basics.name,
  jobTitle: cv.basics.label,
  description: cv.basics.headline,
  url: cv.basics.url,
  sameAs: cv.basics.profiles.map((p) => p.url),
  knowsAbout: cv.skills.flatMap((group) => group.items),
  hasOccupation: {
    '@type': 'Occupation',
    name: cv.basics.label,
    occupationalCategory: '17-2072.00', // O*NET: Electronics Engineers
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={cv.basics.name} />
    <meta
      name="twitter:card"
      content={ogImageUrl ? 'summary_large_image' : 'summary'}
    />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    {/* Runs before first paint so the theme never flashes. `is:inline` keeps
        it out of the bundle — it must not be deferred. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          /* private mode / storage blocked — CSS media query handles it */
        }
      })();
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>

  <body class="min-h-dvh flex flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <Navigation />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
