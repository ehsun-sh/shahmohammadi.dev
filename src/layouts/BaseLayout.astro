---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { cv } from '../data/cv';

interface Props {
  title: string;
  description: string;
  /** Root-relative path to a social card. Built by `src/pages/og.png.ts`. */
  ogImage?: string;
}

const { title, description, ogImage = '/og.png' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle =
  title === cv.basics.name ? title : `${title} — ${cv.basics.name}`;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// Recruiters google you before they read you. This is what shows up.
// Placeholder profile URLs are filtered out — pointing sameAs at a 404 is worse
// than omitting the property.
const currentRole = cv.work.find((job) => job.endDate === null);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${cv.basics.url}/#person`,
  name: cv.basics.name,
  jobTitle: cv.basics.label,
  description: cv.basics.headline,
  url: cv.basics.url,
  image: new URL('/apple-touch-icon.png', Astro.site).href,
  email: `mailto:${cv.basics.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: cv.basics.location.city,
    addressCountry: cv.basics.location.countryCode,
  },
  sameAs: cv.basics.profiles
    .map((p) => p.url)
    .filter((url) => !url.includes('TODO')),
  knowsAbout: cv.skills.flatMap((group) => group.items),
  knowsLanguage: cv.languages.map((entry) => entry.language),
  alumniOf: cv.education.map((entry) => ({
    '@type': 'CollegeOrUniversity',
    name: entry.institution,
  })),
  award: cv.awards.map((entry) => entry.title),
  ...(currentRole && {
    worksFor: { '@type': 'Organization', name: currentRole.company },
  }),
  hasOccupation: {
    '@type': 'Occupation',
    name: cv.basics.label,
    occupationalCategory: '17-2072.00', // O*NET: Electronics Engineers
  },
};

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: { '@id': `${cv.basics.url}/#person` },
  url: canonical,
  name: fullTitle,
  description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* One multi-resolution .ico covers 16→256 for every desktop browser. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta
      name="theme-color"
      content="#fbfbfd"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#000000"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="author" content={cv.basics.name} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={cv.basics.name} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${cv.basics.name} — ${cv.basics.label}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Runs before first paint so the theme never flashes. `is:inline` keeps
        it out of the bundle — it must not be deferred. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          /* private mode / storage blocked — CSS media query handles it */
        }
      })();
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify([personSchema, profilePageSchema])}
    />

    <Analytics />
  </head>

  <body class="min-h-dvh flex flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <Navigation />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
