---
import { Image } from 'astro:assets';
import { resolveProjectImage } from '../lib/projectImages';

/**
 * The picture beside a project entry, or the frame where one will go.
 *
 * The filename-to-asset resolution — and the build error when a name matches
 * nothing — lives in `src/lib/projectImages.ts`, shared with the cover on the
 * project page so the two can never disagree about which file is which.
 */

interface Props {
  image: string | null;
  alt: string;
  /** Project name, used to describe the placeholder while the image is absent. */
  name: string;
  /** The caller owns the width — beside a CV entry it is a fixed 160px, in the
   *  index grid it fills its column. The ratio is not negotiable either way. */
  class?: string;
}

const { image, alt, name, class: className } = Astro.props;

const resolved = resolveProjectImage(image, name);

// 16:10, the same ratio as the hero visual, so the two never disagree about
// what shape a picture on this site is.
const RATIO = '16 / 10';
---

<div
  class:list={['w-full shrink-0', className]}
  style={`aspect-ratio: ${RATIO}`}
>
  {
    resolved ? (
      <Image
        src={resolved}
        alt={alt}
        widths={[160, 320, 640]}
        sizes="(min-width: 640px) 160px, 100vw"
        loading="lazy"
        decoding="async"
        class="size-full rounded-card border border-subtle object-cover"
      />
    ) : (
      /* Not a broken-image icon and not invisible: a deliberate empty frame,
         so the row keeps its shape and the gap reads as "picture pending"
         rather than as a layout bug. aria-hidden because there is nothing to
         describe yet — the project title already names the entry. */
      /* Filled with the page ground, not the card colour — the frame sits on a
         white card now, and --color-surface would have been white on white
         with only the dashes to prove anything was there. */
      <div
        class="size-full rounded-card border border-dashed border-border bg-bg"
        aria-hidden="true"
      />
    )
  }
</div>
