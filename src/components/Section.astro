---
interface Props {
  id: string;
  title: string;
  /** Optional one-line note rendered under the heading. */
  note?: string;
}

const { id, title, note } = Astro.props;
---

{/*
  The rule sits under the heading, full width — the shape a printed CV or a spec
  sheet uses, where the line closes the heading rather than floating above it as
  a separate mark. Plain hairline: colour is spent on the primary action, the
  availability dot and the hero, and a marker on every section would dilute it.
*/}
<section id={id} class="scroll-mt-24 pt-16 pb-2">
  <h2 class="text-heading">{title}</h2>

  <div class="mt-3.5 h-px w-full bg-border" aria-hidden="true"></div>

  {note && <p class="mt-4 text-meta text-muted">{note}</p>}

  <div class:list={[note ? 'mt-5' : 'mt-8']}>
    <slot />
  </div>
</section>
