---
interface Props {
  id: string;
  title: string;
  /** Optional one-line note rendered under the heading. */
  note?: string;
}

const { id, title, note } = Astro.props;
---

{/*
  One card per section. The plate is what separates this section from the next
  now — the vertical gap between cards used to be doing that job alone, and it
  needed 64px of it to be legible as a break. 20px of ground between two edges
  says the same thing in a third of the space, which is why the page reads as
  denser without anything actually being crowded.

  The rule stays under the heading, full width — the shape a printed CV or a
  spec sheet uses, where the line closes the heading rather than floating above
  it as a separate mark. It is the soft grey, not the border grey: inside a
  card it is dividing a title from its own content, not one region from
  another, and at --color-border it read as a second card edge 40px below the
  first. Plain hairline, no marker: colour is spent on the primary action, the
  availability dot and the hero.
*/}
<section id={id} class="card scroll-mt-20">
  <h2 class="text-heading">{title}</h2>

  <div class="mt-3 h-px w-full bg-subtle" aria-hidden="true"></div>

  {note && <p class="mt-4 text-meta text-muted">{note}</p>}

  <div class="mt-5">
    <slot />
  </div>
</section>
