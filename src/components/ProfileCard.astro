---
import { Image } from 'astro:assets';
import SocialIcon from './SocialIcon.astro';
import { cv, locationLabel } from '../data/cv';
import { site } from '../data/site';

/**
 * The identity rail.
 *
 * Everything a recruiter needs before they have read a word of the CV — who
 * this is, where they are, whether they are available, how to reach them, and
 * the PDF — held in one card that stays on screen while the CV scrolls past it.
 * That is the whole argument for a sidebar: those five facts are needed at
 * every point in the page, and in a single column they are only available at
 * the top of it.
 *
 * It carries the page's <h1>. The name is the heading of this document; the
 * landing page has no masthead any more, and inventing a second, larger name
 * somewhere else would mean two h1s or a heading that outranks the real one.
 *
 * Landing page only. /services and /contact are addressed to clients, not
 * recruiters, and a "download my résumé" rail on a services page argues against
 * the page it is sitting on.
 */

/**
 * Two portraits, one per theme, and both are shipped.
 *
 * A `<picture>` with `media="(prefers-color-scheme: dark)"` would fetch only
 * one, and it would be the wrong one for anyone who has used the theme toggle:
 * this site resolves its theme from localStorage first and the OS preference
 * only as a default, so the media query is not the source of truth. The `dark`
 * variant in global.css is — it matches both the attribute and the JS-disabled
 * fallback — so the pair is rendered and CSS picks. The cost is the unused
 * file, and at a 288px box that is a few KB against always being right.
 *
 * Static imports rather than the glob the thumbnails use: those are optional
 * and these are not, so a missing file should fail the build rather than
 * quietly render a card with no face in it.
 */
import portraitLight from '../assets/portrait-light.webp';
import portraitDark from '../assets/portrait-dark.webp';

const { basics } = cv;

/** Identical for both, and only one is ever in the a11y tree — the other is
 *  `display: none`, which takes it out. */
const portraitAlt = `${basics.name}, ${basics.label}`;

/**
 * The three widths the portrait is actually rendered at, in the order the
 * browser tests them. They are the same three cases the `<style>` block below
 * reasons about: 286 in the rail, the 22rem cap while the rail is stacked but
 * the card is wide, and the card's own inner width on a phone — 100vw less the
 * page's 48px of gutters, 2px of card border and 32px of card padding.
 *
 * Worth writing out rather than leaving at a single figure: `sizes` is what
 * picks from `widths`, so one number here means every other viewport either
 * upscales a too-small file or downloads a too-big one, and this pair of images
 * is fetched on the landing page before anything below the fold.
 */
const PORTRAIT_SIZES =
  '(min-width: 64rem) 286px, (min-width: 34rem) 352px, calc(100vw - 82px)';

// Placeholder profile URLs never reach the live site; in dev they render dimmed
// so the row is visible while cv.json is still being filled in.
const isPlaceholder = (url: string) => url.includes('TODO');
const profiles = import.meta.env.DEV
  ? basics.profiles
  : basics.profiles.filter((profile) => !isPlaceholder(profile.url));

// Label / value pairs, so the rail reads as a spec sheet rather than a
// paragraph. `remote` is a fact a recruiter filters on, so it gets its own row
// instead of being appended to the location.
const facts = [
  { label: 'Based in', value: locationLabel },
  ...(basics.location.remote
    ? [{ label: 'Works', value: 'Remotely, with teams anywhere' }]
    : []),
];
---

<div class="card">
  <Image
    src={portraitLight}
    alt={portraitAlt}
    widths={[286, 352, 572, 704]}
    sizes={PORTRAIT_SIZES}
    loading="eager"
    decoding="async"
    class="portrait block dark:hidden"
  />
  <Image
    src={portraitDark}
    alt={portraitAlt}
    widths={[286, 352, 572, 704]}
    sizes={PORTRAIT_SIZES}
    loading="eager"
    decoding="async"
    class="portrait hidden dark:block"
  />

  <h1 class="mt-4 text-heading">{basics.name}</h1>
  <p class="mt-1 text-meta text-muted">{basics.label}</p>

  <div class="mt-4 h-px w-full bg-subtle" aria-hidden="true"></div>

  {
    basics.availability.open && basics.availability.note && (
      <p class="mt-4 flex items-start gap-2.5 text-meta">
        <span class="status-dot mt-1.5 shrink-0" aria-hidden="true" />
        {basics.availability.note}
      </p>
    )
  }

  <dl class="mt-3 space-y-1 text-meta">
    {
      facts.map((fact) => (
        <div class="flex flex-wrap gap-x-1.5">
          {/* The label is the semibold half of the pair, which is what the
              reference does and what makes a two-line spec block scannable
              without a second colour or a second size. */}
          <dt class="font-semibold">{fact.label}:</dt>
          <dd class="text-muted">{fact.value}</dd>
        </div>
      ))
    }
    <div class="flex flex-wrap gap-x-1.5">
      <dt class="font-semibold">Email:</dt>
      <dd class="min-w-0">
        <a
          href={`mailto:${basics.email}`}
          class="break-all text-accent transition-colors hover:underline"
        >
          {basics.email}
        </a>
      </dd>
    </div>
  </dl>

  {/* Full-width stacked buttons, not a wrapped row: the rail is 20rem and two
      side-by-side buttons in it would each be too narrow to read as the
      primary action. */}
  <div class="mt-5 flex flex-col gap-2">
    {
      site.resumeReady && (
        <a href="/resume.pdf" class="btn btn-primary w-full">
          Download résumé
        </a>
      )
    }
    <a
      href="/contact/"
      class:list={[
        'btn w-full',
        site.resumeReady ? 'btn-secondary' : 'btn-primary',
      ]}
    >
      Get in touch
    </a>
  </div>

  {
    profiles.length > 0 && (
      <ul class="mt-4 flex flex-wrap items-center gap-1">
        {profiles.map((profile) => (
          <li>
            <a
              href={profile.url}
              rel="me noopener"
              aria-label={profile.network}
              title={
                isPlaceholder(profile.url)
                  ? `${profile.network} — URL not set in cv.json`
                  : profile.network
              }
              class:list={[
                'grid size-9 place-items-center rounded transition-colors hover:bg-subtle hover:text-accent',
                isPlaceholder(profile.url) && 'opacity-30',
              ]}
            >
              <SocialIcon network={profile.network} />
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  /**
   * The portrait sits nearly full-bleed in the rail, held off the card's edges
   * by 16px on the top and both sides — inside the 10–20px the brief asked for,
   * and the same 16px in every arrangement rather than a different number per
   * breakpoint.
   *
   * That takes a negative margin, because the card's own padding is 24px and
   * the picture has to come back out through 8px of it. Below 34rem the card
   * is already at 16px, so the pull is removed rather than doubled up — it
   * would land the picture on 8px there and break the one thing this rule is
   * for.
   *
   * `max-width` is the part that is not obvious. The rail only exists above
   * `lg`; below it the card is the full page width, and `100% + 1rem` on a
   * 768px tablet is a 686px portrait sitting in the middle of the page. So
   * there is a cap — but it is 22rem and not the rail's own 286px, and the
   * difference matters twice.
   *
   * On a phone, a cap at 286 binds just under the 293px actually available and
   * leaves the picture hung to the left with 17px on one side and 24px on the
   * other, which is outside the brief and looks like a mistake rather than a
   * decision. At 22rem it does not bind at all below 430px, so the picture
   * fills its row and the insets stay symmetric.
   *
   * And 34rem is where the card's own padding steps 24 → 16, so a cap that
   * binds on one side of it and not the other puts a 461px portrait at 543px
   * and a 286px one at 545px. At 22rem the cap is already binding on both
   * sides of that boundary and nothing jumps across it.
   */
  /* No `display` here, deliberately. Astro compiles a scoped rule to
     `.portrait[data-astro-cid-…]`, which outranks Tailwind's `.hidden`, so a
     `display: block` in this block silently un-hides the theme that is meant to
     be off and ships both portraits stacked. Display belongs to the utilities;
     this rule owns geometry only. */
  .portrait {
    width: calc(100% + 1rem);
    max-width: 22rem;
    margin: -0.5rem -0.5rem 0;
    aspect-ratio: 1;
    object-fit: cover;
    /* The one radius on the site. A second one here would read as a second
       material sitting on the card rather than as part of it. */
    border-radius: var(--radius-card);
  }

  @media (width < 34rem) {
    .portrait {
      width: 100%;
      margin: 0;
    }
  }
</style>
