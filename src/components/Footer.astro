---
import SocialIcon from './SocialIcon.astro';
import { cv } from '../data/cv';

interface Props {
  /** Matches the page's own container, like the nav bar. See BaseLayout. */
  shell?: 'page' | 'wide';
}

const { shell = 'page' } = Astro.props;

const year = new Date().getFullYear();

// Placeholder URLs never reach the live site. In dev they render dimmed so the
// icon set is visible while cv.json is still being filled in.
const isPlaceholder = (url: string) => url.includes('TODO');
const profiles = import.meta.env.DEV
  ? cv.basics.profiles
  : cv.basics.profiles.filter((profile) => !isPlaceholder(profile.url));
---

{/* The rule sits at the footer's top edge, so the space above it comes entirely
    from the page wrapper's `pb-8` — 32px, against the 33px of `py-8` below it,
    which puts the rule centred in its own whitespace. Every page wrapper uses
    the same pb-8 for exactly this reason. If one changes, re-measure.

    Measuring the copyright line's own box gives 41px, not 33: the row is
    `items-center` and the icon buttons are 36px tall against its 20px, so the
    text is optically centred and its top sits 8px lower than the padding. The
    rule is balanced against the block, which is what the eye reads. */}
<footer class="border-t border-subtle">
  <div
    class:list={[
      'mx-auto flex flex-col gap-5 px-6 py-8 text-meta text-muted sm:flex-row sm:items-center',
      shell === 'wide' ? 'max-w-page lg:max-w-wide' : 'max-w-page',
    ]}
  >
    <p>© {year} {cv.basics.name}</p>

    <ul class="flex flex-wrap items-center gap-1 sm:ml-auto">
      {
        profiles.map((profile) => (
          <li>
            <a
              href={profile.url}
              rel="me noopener"
              aria-label={profile.network}
              title={
                isPlaceholder(profile.url)
                  ? `${profile.network} — URL not set in cv.json`
                  : profile.network
              }
              class:list={[
                'grid size-9 place-items-center rounded-full transition-colors hover:bg-surface hover:text-accent',
                isPlaceholder(profile.url) && 'opacity-30',
              ]}
            >
              <SocialIcon network={profile.network} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
