---
import SocialIcon from './SocialIcon.astro';
import { cv } from '../data/cv';

const year = new Date().getFullYear();

// Placeholder URLs never reach the live site. In dev they render dimmed so the
// icon set is visible while cv.json is still being filled in.
const isPlaceholder = (url: string) => url.includes('TODO');
const profiles = import.meta.env.DEV
  ? cv.basics.profiles
  : cv.basics.profiles.filter((profile) => !isPlaceholder(profile.url));
---

{/* The rule sits at the footer's top edge, so only this margin can open the
    space above it — and it is not the whole story: the last Section's `pb-2`
    and the page wrapper's `pb-4` already contribute 24px. mt-4 brings the total
    to 40px, matching the 41px that falls between the rule and the copyright
    line below it, so the rule sits centred in its own whitespace. It was mt-24,
    which put 120px above against 41px below and left a visible hole under the
    last section. If Section's bottom padding ever changes, re-measure. */}
<footer class="mt-4 border-t border-border/70">
  <div
    class="mx-auto flex max-w-page flex-col gap-5 px-6 py-8 text-meta text-muted sm:flex-row sm:items-center"
  >
    <p>© {year} {cv.basics.name}</p>

    <ul class="flex flex-wrap items-center gap-1 sm:ml-auto">
      {
        profiles.map((profile) => (
          <li>
            <a
              href={profile.url}
              rel="me noopener"
              aria-label={profile.network}
              title={
                isPlaceholder(profile.url)
                  ? `${profile.network} — URL not set in cv.json`
                  : profile.network
              }
              class:list={[
                'grid size-9 place-items-center rounded-full transition-colors hover:bg-surface hover:text-accent',
                isPlaceholder(profile.url) && 'opacity-30',
              ]}
            >
              <SocialIcon network={profile.network} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
