---
// Progressive enhancement: hidden until the script upgrades it, so visitors
// without JS never see a control that does nothing. The OS preference still
// drives the palette for them (see global.css).
---

<button
  type="button"
  data-theme-toggle
  hidden
  aria-label="Switch theme"
  class="grid size-8 place-items-center rounded-full text-muted transition-colors hover:bg-surface hover:text-text"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    class="size-[18px]"
  >
    <g class="hidden dark:block">
      <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z" />
    </g>
    <g class="dark:hidden">
      <circle cx="12" cy="12" r="4" />
      <path
        d="M12 3v1.8M12 19.2V21M21 12h-1.8M4.8 12H3M18.4 5.6l-1.3 1.3M6.9 17.1l-1.3 1.3M18.4 18.4l-1.3-1.3M6.9 6.9 5.6 5.6"
      />
    </g>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;

  if (button) {
    button.hidden = false;
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage blocked — the choice just won't persist */
      }
    });
  }
</script>
