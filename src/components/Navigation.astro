---
import { Image } from 'astro:assets';
import ThemeToggle from './ThemeToggle.astro';
import logo from '../assets/brand/logo.jpg';
import { cv } from '../data/cv';
import { site } from '../data/site';

// Anchors for now — dedicated pages get swapped in as their phases land, which
// is what the site.*Ready flags gate. Nothing here may point at a 404.
// Four is the ceiling: at the 640px breakpoint the name plus five labels came
// to exactly the viewport width, with nothing left for a longer label or a
// wider font fallback. Skills came out because it is one scroll from Experience
// and is the only anchor here that is not a destination in its own right.
const links = [
  { href: '/#experience', label: 'Experience', show: true },
  { href: '/#projects', label: 'Projects', show: !site.projectsReady },
  { href: '/projects', label: 'Projects', show: site.projectsReady },
  { href: '/services', label: 'Services', show: site.servicesReady },
  { href: '/notes', label: 'Notes', show: site.notesReady },
  { href: '/resume.pdf', label: 'Résumé', show: site.resumeReady },
  { href: '/contact', label: 'Contact', show: site.servicesReady },
].filter((link) => link.show);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  class="sticky top-0 z-50 border-b border-border/60 bg-bg/80 backdrop-blur-xl"
>
  <nav
    aria-label="Main"
    class="mx-auto flex h-14 max-w-wide items-center gap-6 px-6"
  >
    {/* The logo is the mark and the name is the label, so they are one link and
        the image is decorative — giving it alt text would make a screen reader
        announce the name twice. */}
    <a
      href="/"
      class="group flex items-center gap-2.5"
      aria-current={path === '/' ? 'page' : undefined}
    >
      <Image
        src={logo}
        alt=""
        width={26}
        height={26}
        densities={[1, 2]}
        loading="eager"
        class="size-[26px] rounded-[7px]"
      />
      <span
        class="text-meta font-semibold transition-colors group-hover:text-accent"
      >
        {cv.basics.name}
      </span>
    </a>

    <ul class="ml-auto flex items-center gap-1">
      {/* The anchor links do not fit beside the name at 375px, and this is a
          single-column page where scrolling reaches everything anyway — so they
          drop out below sm rather than forcing the bar to scroll sideways. */}
      {
        links.map((link) => (
          <li class="hidden sm:block">
            <a
              href={link.href}
              class="rounded-md px-2 py-1.5 text-meta text-muted transition-colors hover:text-text"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="ml-1">
        <ThemeToggle />
      </li>
    </ul>
  </nav>
</header>
