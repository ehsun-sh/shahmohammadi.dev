---
import ThemeToggle from './ThemeToggle.astro';
import BrandMark from './BrandMark.astro';
import { cv } from '../data/cv';
import { site } from '../data/site';

interface Props {
  /** Matches the page's own container so the mark lines up with the card
   *  underneath it. See BaseLayout for why this is a prop and not a constant. */
  shell?: 'page' | 'wide';
}

const { shell = 'page' } = Astro.props;

// Dedicated pages replace their anchors as each phase lands, which is what the
// site.*Ready flags gate. Nothing here may point at a 404.
const links = [
  { href: '/', label: 'Home', show: true },
  { href: '/#experience', label: 'Experience', show: true },
  { href: '/#projects', label: 'Projects', show: !site.projectsReady },
  { href: '/projects', label: 'Projects', show: site.projectsReady },
  { href: '/services', label: 'Services', show: site.servicesReady },
  { href: '/notes', label: 'Notes', show: site.notesReady },
  { href: '/resume.pdf', label: 'Résumé', show: site.resumeReady },
  { href: '/contact', label: 'Contact', show: site.servicesReady },
].filter((link) => link.show);

// Both sides go through the same normalizer. Stripping the trailing slash
// without the `|| '/'` fallback turns the root into an empty string, which
// never matches the pathname and silently leaves Home unmarked.
const normalize = (value: string) => value.replace(/\/+$/, '') || '/';

const path = normalize(Astro.url.pathname);

const isCurrent = (href: string) =>
  !href.startsWith('/#') && normalize(href) === path;
---

{/* Solid white, not a translucent tint of the page. Two reasons and both are
    load-bearing: it is the same white as the cards, so the bar reads as part of
    the same material system; and it is the only surface outside a card where
    accent-coloured text appears — the brand lockup on hover — which needs white
    underneath it to clear 4.5:1. A blurred tint would have put that hover at
    4.4:1 against the ground. */}
<header class="sticky top-0 z-50 border-b border-subtle bg-surface">
  <nav
    aria-label="Main"
    class:list={[
      'mx-auto flex h-14 items-center gap-4 px-6 lg:gap-6',
      // Mirrors the landing page's own container swap exactly: it is `page`
      // until the rail appears at `lg`, and `wide` after.
      shell === 'wide' ? 'max-w-page lg:max-w-wide' : 'max-w-page',
    ]}
  >
    {/* Mark and name are one link, and the mark is decorative — it is the same
        word as the name beside it, so labelling it would make a screen reader
        say the name twice. The name only appears at lg: with six labels,
        showing it from md left 35px of slack at 768px, which one longer label
        or a wider font fallback would have eaten. The mark alone identifies the
        site below that, and aria-label keeps the link named at every width.

        Both halves inherit one colour and shift to the accent together on
        hover, which is what makes them read as a single lockup rather than an
        icon that happens to sit beside some text. */}
    <a
      href="/"
      class="group flex shrink-0 items-center gap-2.5 transition-colors hover:text-accent"
      aria-label={cv.basics.name}
    >
      <BrandMark class="size-[26px]" />
      <span class="hidden text-meta font-semibold lg:inline">
        {cv.basics.name}
      </span>
    </a>

    <ul class="ml-auto flex items-center gap-1">
      {/* The labels do not fit beside the mark at 375px, and this is a
          single-column site where scrolling reaches everything anyway — so they
          drop out below sm rather than forcing the bar to scroll sideways. */}
      {
        links.map((link) => (
          <li class="hidden sm:block">
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class="rounded px-2 py-1.5 text-meta text-muted transition-colors hover:text-text aria-[current=page]:text-text"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="ml-1">
        <ThemeToggle />
      </li>
    </ul>
  </nav>
</header>
