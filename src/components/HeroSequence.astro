---
import { getHeroManifest } from '../lib/heroFrames';
import BrandMark from './BrandMark.astro';
import { cv } from '../data/cv';

/**
 * The scroll-driven product sequence.
 *
 * Four stages over one pinned screen: the board assembles, the enclosure
 * closes, the object recedes, the name arrives, the name leaves and the CV
 * begins. The frames are a pre-rendered sequence scrubbed on a canvas — see
 * scripts/build-hero-frames.mjs for why that and not a real-time 3D scene.
 *
 * THE PIN IS `position: sticky`, NOT JAVASCRIPT.
 * The section is 350vh tall and holds one 100dvh sticky child, which gives
 * exactly 250vh of travel — the documented ceiling — without touching the
 * scroll position. Nothing here scroll-jacks: the page scrolls natively at
 * whatever speed the visitor's own input device says, and the only thing script
 * does is read a number and draw. A momentum flick, a trackpad, a Page Down
 * key and a screen reader's caret all behave the way the visitor expects,
 * because none of them are being intercepted.
 *
 * WHAT HAPPENS WITH NO JAVASCRIPT
 * The section is one screen tall and shows the poster — the closed enclosure,
 * the end of the story — with the name under it, and the CV follows normally.
 * `data-hero-active` is set by script and only by script, so every "tall,
 * pinned, animated" rule in the stylesheet is opt-in. Nothing is hidden waiting
 * for a class that will never arrive, which is the usual way this effect breaks
 * a page.
 *
 * `prefers-reduced-motion: reduce` takes the same path as no-JS. Not a
 * shortened animation — no animation.
 */

const manifest = getHeroManifest();

/**
 * With no frames this component is only mounted by `npm run dev` — index.astro
 * gates it — because the alternative in a build is a full screen holding a name
 * and no picture, which is a hole rather than a hero. That is the same call the
 * project cover makes at the same size and for the same reason: a placeholder
 * is a design element at 160px and a defect at 1500. The page then simply
 * starts at the CV, which is a complete page on its own.
 */

/**
 * There is no `tone` prop and there should not be one.
 *
 * The render has a transparent background, so the page's own ground shows
 * through it and every colour on this screen is already the theme's colour —
 * the name is `--color-text` in both themes because it is ordinary text on the
 * ordinary page, not text over an image. A baked-in background would have
 * needed the page to be told which ink to use over it; transparency deletes
 * the question instead of answering it.
 *
 * It also means one silver render covers both themes. A second, darker render
 * for dark mode would be worse, not better: dark metal on a black ground loses
 * its silhouette, while the light one keeps its edges against both.
 */
/**
 * The opening title card.
 *
 * It is a layer inside the pinned stage, not a screen ahead of it, and that is
 * a reversal of the first attempt. The argument against folding it in was that
 * a held title would have to come out of the frames — true at 350vh, where the
 * frames turn over every ~23px of scroll and giving the title a sixth of the
 * section drops that to ~18px. The answer is not to keep the card outside the
 * pin; it is to make the section long enough to carry both. At 400vh the frames
 * get the same ~23px they had before AND the card gets its beat, and the whole
 * hero is 400vh instead of the 450vh that a separate screen plus a 350vh pin
 * cost. Longer pin, shorter page. See constraint 3 in CLAUDE.md, which moved
 * with it.
 *
 * What this buys is that the sequence is now one continuous piece rather than a
 * screen that scrolls away followed by an animation that starts. The card holds,
 * dissolves as the object grows in behind it, and the whole thing runs in
 * reverse at the far end — the object shrinks away, the closing plate grows in,
 * and the interface arrives last.
 *
 * The mark and the name live here rather than in the header for the same
 * reason: the header is chrome, and chrome arrives after the title sequence,
 * not during it. The header carries its own copy for every other page and for
 * the no-JS path, and fades in on the closing plate's exit.
 *
 * The line lives here and not in cv.json, which is for facts the résumé prints
 * too. This is the site's thesis, and the PDF has no place to put it.
 *
 * Lower-case `from` on purpose. It is set in a script face as a subtitle to the
 * name above it, not as a headline of its own — a capital there would make it a
 * second statement competing with the first.
 */
const HEADLINE = 'from Concept to Product';

const poster = manifest ? '/hero/poster.webp' : null;
const alt =
  'The product this site is about: a printed circuit board assembling itself ' +
  'from its component parts, and the finished enclosure closing over it.';
---

{
  manifest && (
    /* Runs during parse, before the hero paints, for the same reason the theme
       script does: the module script below is deferred, so between first paint
       and hydration the section would render one screen tall with the name at
       full size, then jump to 350vh with the name invisible. One frame of the
       wrong layout is worse than no animation.

       Everything the stylesheet does for the animated state hangs off this
       attribute, so the guards live here and nowhere else — no reduced motion,
       no attribute, no animation. */
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.setAttribute('data-hero-active', '');
      }
    </script>
  )
}

<section
  class="hero"
  data-hero
  data-count={manifest?.count}
  data-widths={manifest?.widths.join(',')}
  data-zoom={manifest && `${manifest.zoom.start},${manifest.zoom.end}`}
  aria-label="Product animation"
>
  <div class="hero-stage">
    {/* One of the four things colour is spent on, and the only one that has to
        be here: the enclosure's brightest faces sit within a few percent of the
        light theme's ground, so on a laptop panel its top edge would otherwise
        dissolve into the page. The glow gives the object something to sit on
        without drawing a plate under it. It fades out with the object in stage
        three. */}
    <div class="hero-glow" data-hero-glow aria-hidden="true"></div>
    {
      manifest ? (
        <>
          {/* The poster is the LCP element and the only thing painted until the
              sequence has downloaded. It stays in the DOM under the canvas
              rather than being swapped out, so a failed fetch of the frames
              degrades to a still picture instead of an empty box.

              Its dimensions come from the manifest rather than being written
              here: the poster is encoded at the widest configured width and
              cropped to the union alpha box, so a literal would go stale the
              first time either changes and would then reserve the wrong space
              while the image loads. A comment cannot sit between the attributes
              of a JSX element — Astro parses it as attributes — which is why
              this one is up here. */}
          <img
            src={poster}
            alt={alt}
            width={manifest.widths.at(-1)}
            height={Math.round(manifest.widths.at(-1)! / manifest.aspect)}
            fetchpriority="high"
            decoding="async"
            class="hero-media hero-poster"
            data-hero-poster
          />
          <canvas class="hero-media hero-canvas" data-hero-canvas aria-hidden="true"
          ></canvas>
        </>
      ) : (
        import.meta.env.DEV && (
          /* Dev only, like every other slot on this site that is waiting for an
             asset. It carries the command, because the thing you need when you
             see this frame is the thing that fills it. */
          <div class="hero-pending" aria-hidden="true">
            <p class="text-heading">Hero sequence</p>
            <p class="text-meta">
              <code class="font-mono">npm run hero -- "&lt;render folder&gt;"</code>
            </p>
            <p class="text-meta">
              Writes public/hero/ and the manifest. Until then this section is
              one screen tall and does not pin.
            </p>
          </div>
        )
      )
    }

    {/* Beat one, and the mirror of the plate below it. Identity on top, the
        thesis in the middle, the cue at the foot — the shape a title card has
        had since film had titles.

        The cue is aria-hidden because it is an affordance, not content: "there
        is more below" is something the document structure already says, and the
        skip link in BaseLayout is what actually gets a keyboard past all of
        this. The mark is decorative here too — the name is right beside it in
        real text, so announcing the logo as well would only say it twice. */}
    <div class="hero-intro" data-hero-intro>
      {/* The mark is wrapped in a slot rather than styled directly. BrandMark
          injects the artwork with `set:html`, so the <svg> never receives the
          `data-astro-cid-*` attribute that scoped rules are compiled against —
          a scoped rule on the mark itself matches nothing and it renders 0×0.
          A span written in this template does get the attribute, so the slot is
          what moves between the two arrangements and the svg just fills it. */}
      <div class="hero-lead">
        <p class="hero-lockup">
          <span class="hero-mark-slot">
            <BrandMark class="block size-full" />
          </span>
          <span class="hero-fullname">{cv.basics.name}</span>
        </p>

        <p class="hero-tagline">{HEADLINE}</p>
      </div>

      <span class="hero-scroll" aria-hidden="true">
        <span class="hero-scroll-label">Scroll Down</span>
        <svg
          class="hero-scroll-mark"
          width="18"
          height="10"
          viewBox="0 0 18 10"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M1 1l8 8 8-8" />
        </svg>
      </span>
    </div>

    {/* Beat four. Present in the HTML from the start — it is the page's
        identity, not a payload the animation delivers — and simply not
        transformed when script is not driving it. */}
    <div class="hero-title" data-hero-title>
      <p class="hero-kicker">Designed by</p>
      <p class="hero-name">{cv.basics.name}</p>
    </div>
  </div>
</section>

<style>
  /* ------------------------------------------------------------ intro --- */

  /* Three tracks, and the two `1fr` ones are what make the arrangement hold at
     any height instead of being a guess.
       row 1  empty
       row 2  the name, with the mark hung above it and the tagline below
       row 3  the cue, centred in it
     Rows 1 and 3 split the leftover equally, so the lead block lands on the
     screen's centre line; centring the cue inside row 3 puts it exactly halfway
     between the bottom of the lead and the bottom of the screen, wherever
     those two end up. A margin could only ever approximate that, and would
     drift the moment the headline wrapped to a different number of lines.
     `minmax(0, …)` rather than a bare `1fr`: on a short viewport the cue would
     otherwise grow its own track and shove the lead block off centre. */
  .hero-intro {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto minmax(0, 1fr);
    justify-items: center;
    /* No vertical padding at all, because both of the things this card
       promises are measured against the screen and not against a padding box.
       The grid's tracks end at the padding edge, so a value here would land the
       name half of it low and the cue half of it high — "near the middle"
       rather than the middle. Nothing is at risk from losing the cushion: the
       tagline and the mark hang off the name rather than sitting in a track, so
       a short viewport shrinks the empty tracks instead of pushing anything
       against an edge. */
    padding: 0 1.5rem;
    text-align: center;
    /* The exact inverse of what `.hero-title` does on the way out: it fades in
       while growing from 0.72, so this fades out while shrinking to it. Script
       writes both; these defaults are the state every fallback path renders. */
    transform: scale(var(--hero-intro-scale, 1));
    opacity: var(--hero-intro-opacity, 1);
    will-change: transform, opacity;
    /* The cue is the only thing here anyone could want to point at, and it is
       not interactive. Letting the layer swallow clicks would put an invisible
       sheet over the canvas for the rest of the sequence. */
    pointer-events: none;
  }

  /* The card's measurements, all four derived from the name and none of them
     chosen.

     The mark is sized off the name rather than independently, because the brief
     is a relationship and not a number: the mark's vertical edge should measure
     the same as the cap height of the E beside it.

     Solving it needs three facts out of logo.svg. The artwork spans 891.2 of
     the 1000-unit viewBox vertically; its outer vertical edges measure 445.7;
     and 891.2 / 445.7 = 1.9993, so the artwork is exactly twice its own edge.
     Edge = cap height therefore means artwork = 2 cap heights, and the svg box
     is 1000/891.2 larger again — 2.2435 cap heights, which at Noto Sans' 0.714
     cap is 1.6018em of the name. Re-derive this if the artwork ever changes;
     do not nudge it.

     These live on the card rather than on the lead block because the cue needs
     two of them as well, and they must not drift between the two rules: both
     the mark and the tagline are hung out of the flow, so anything that has to
     reason about where the card actually ends has to be able to add their
     heights back on itself. */
  .hero-intro {
    --name-size: clamp(2rem, 7.4vw, 5.25rem);
    --mark-size: calc(var(--name-size) * 1.6018);
    /* The artwork fills 77.3% of the square box, leaving 11.35% blank down each
       side. Pulling that back in is what makes `--mark-gap` the gap you can
       actually see, rather than the gap plus a strip of nothing. */
    --mark-bleed: calc(var(--mark-size) * -0.1135);
    --mark-gap: clamp(0.85rem, 1.8vh, 1.35rem);
    /* 0.72 of the name, which is far more than a standfirst would take and is
       the right number for this face: Grand Hotel's cap height is roughly 0.62em
       against Noto's 0.714, so 0.72 of the size lands the two capitals within a
       few percent of each other and the line reads as a subtitle written under
       the name rather than a caption stuck to it. */
    --tagline-size: calc(var(--name-size) * 0.72);
    /* The gap between the two BOXES, which is not the gap anyone sees. The
       name's line box carries a descender's worth of room that "Ehsan
       Shahmohammadi" never uses, and Grand Hotel's box is mostly ascender
       clearance above a small x-height; stacked, those two empty bands measure
       0.164em of the name. So visible gap = this + 0.164em, and the target is
       0.36em of ink between the name's baseline and the tagline's ascenders —
       the proportion in the reference, read off the two strings' *widths*
       rather than their heights, because a width is a whole line long and
       survives being measured by eye where a cap height is thirty pixels and
       does not.
       Re-measure the ink, not the boxes, if either size moves. */
    --tagline-gap: calc(var(--name-size) * 0.196);
    /* The height the tagline takes below the lead block. It is out of the flow,
       so this is the only way anything else on the card can know about it. */
    --tagline-block: calc(var(--tagline-size) * 1.1 + var(--tagline-gap));
  }

  .hero-lead {
    position: relative;
    grid-row: 2;
    align-self: center;
  }

  /* Out of the flow and hung off the bottom of the name, which is what lets the
     name itself be the centred thing: anything sharing the name's column in the
     flow would push it up by half that block's height, and the lead would be
     centred while the name was not. Everything on this card — mark above,
     tagline below — hangs off the name for that one reason.

     Centred on `.hero-lead` rather than on the name, so on desktop it sits
     under the middle of the mark-and-name lockup, not under the middle of the
     text. That is the arrangement in the reference and it is the right one: the
     lockup is the object, and a subtitle centres under the object. */
  .hero-tagline {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 100%;
    margin-top: var(--tagline-gap);
    /* The only script on the site. It is doing something the sans cannot: the
       name above it is the fact and this is the promise, and a second line of
       the same typeface at a smaller size reads as a subtitle of the name
       rather than as a different kind of statement about it.

       No weight declared, because the family has exactly one. Asking for bold
       here would get a synthesised smear across a connecting script — see the
       @font-face note in global.css. */
    font-family: var(--font-script);
    font-size: var(--tagline-size);
    line-height: 1.1;
    color: var(--color-muted);
  }

  .hero-mark-slot {
    position: absolute;
    bottom: calc(100% + var(--mark-gap));
    left: 50%;
    transform: translateX(-50%);
    width: var(--mark-size);
    height: var(--mark-size);
  }

  .hero-lockup {
    position: relative;
  }

  .hero-fullname {
    display: block;
    /* Sized the way `.hero-name` is — by viewport unit, so the longest line
       fits a 375px screen without a breakpoint — and deliberately a step under
       it in size and weight, and not uppercased. The closing plate has to stay
       the heavier of the two: this card opens with the name, the last one
       lands on it, and the payoff should not be the quieter.
       The value is a variable because the mark is derived from it. */
    font-size: var(--name-size);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.04;
    text-wrap: balance;
  }

  /* Desktop: the mark comes down out of its stack and sits beside the name.
     Nothing about the vertical centring changes, and that is why this works
     with the mark in the flow rather than needing another absolute position —
     the row's height is the name's height, because the mark is always the
     shorter of the two, so centring the row still centres the name.

     75rem, and the reason it is that high is worth understanding before anyone
     lowers it. Both the name and the mark are sized in `vw`, so below the
     name's clamp ceiling the pair grows exactly as fast as the screen and the
     slack does not improve at all — it sits at roughly 0% from 768px to 1135px
     no matter how wide the screen gets. Side by side only becomes possible
     once the name stops growing and the measure keeps going. Computed against
     a name that is 11.43em wide and a mark that occupies 1.24em after its
     blank sides are trimmed: 0% at 1024, 2.2% at 1152, 6.2% at 1200, 12.3% at
     1280. 1200 is where it first has room to breathe.

     Below it the stack is the better arrangement anyway — a mark beside a name
     broken over two lines reads as a mistake rather than a lockup. */
  @media (min-width: 75rem) {
    /* The one thing that has to be restated when the mark comes into the flow.
       `.hero-tagline` hangs off the bottom of `.hero-lead`, and with the mark
       beside the name the lead's box no longer ends at the name's foot — it
       ends at the mark's, which is the taller of the two and overhangs by half
       the difference. Subtracting that overhang is what keeps the tagline the
       same distance from the NAME in both arrangements, which is the only
       distance that is visible. Written out of `--mark-size` and the name's
       line-height rather than as a number, so it survives either of them
       moving. */
    .hero-intro {
      --tagline-gap: calc(
        var(--name-size) * 0.196 - (var(--mark-size) - var(--name-size) * 1.04) /
          2
      );
    }

    .hero-lockup {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--mark-gap);
    }

    .hero-mark-slot {
      position: static;
      transform: none;
      flex-shrink: 0;
      margin-inline: var(--mark-bleed);
    }
  }

  /* Explicit row: auto-placement would drop the lead and the cue into tracks 1
     and 2 and leave the third empty, which is the opposite of the arrangement.

     The margin is the one correction the arrangement needs, and it is exact
     rather than eyeballed. Row 3 runs from the bottom of the lead *block* to
     the bottom of the screen, but the tagline is out of the flow and hangs
     `--tagline-block` below that — so centring in the bare row would put the
     cue closer to the tagline than to the foot of the screen. A centred item's
     *margin* box is what gets centred, so a top margin of B moves the cue down
     by exactly B/2, which is exactly the correction. Measured after: 0px off
     the midpoint between the tagline's foot and the bottom of the screen. */
  .hero-scroll {
    grid-row: 3;
    align-self: center;
    margin-top: var(--tagline-block);
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    color: var(--color-muted);
  }

  .hero-scroll-label {
    font-size: var(--text-meta);
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-scroll-mark {
    animation: hero-scroll-bob 2.4s ease-in-out infinite;
  }

  /* 5px, and small on purpose: this has to read as an invitation from the
     corner of the eye while someone is reading the line above it, not as a
     thing competing with it. */
  @keyframes hero-scroll-bob {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.65;
    }
    50% {
      transform: translateY(5px);
      opacity: 1;
    }
  }

  /* ------------------------------------------------------------- pin --- */

  .hero {
    position: relative;
    /* No script: one screen, no pin. `data-hero-active` is what makes it tall,
       and only the client script sets that. */
    min-height: 100dvh;
    background-color: var(--color-bg);
  }

  :global(html[data-hero-active]) .hero {
    /* 400vh of section minus the 100vh sticky child = 300vh of travel, the
       ceiling in CLAUDE.md. Change one number here and the pin distance
       changes with it — and the timings in the script are fractions of it, so
       they all move together and none of them has to be touched.
       It was 350 when the title card was a separate screen ahead of the pin;
       folding the card in and adding its beat here made the hero shorter
       overall, 400vh against 450. */
    height: 400vh;
    min-height: 0;

    /* The stage has to start at the top of the viewport, and everything on this
       card is centred against it — so anything in the flow above the hero
       pushes the whole title card down by its own height. The bar is invisible
       for the whole sequence, so sliding under it is exactly right.

       `--hero-lift` is written by the script, which measures what is actually
       above rather than assuming. The header's 57px was hard-coded here, and it
       was right until something else appeared above the hero: the dev-only
       banner is 60px, and it put the name 60px below the centre line it is
       supposed to be exactly on. A future announcement bar would have done the
       same. The literal survives as the fallback for the frame between CSS
       parse and the module script, where the header is still the only thing
       there.

       Scoped to the animated state, so the ordinary flow is untouched with no
       script and under reduced motion — which is also why measuring this in
       script is not a layering violation: the margin only exists on the path
       where the script is running. */
    margin-top: calc(var(--hero-lift, calc(3.5rem + 1px)) * -1);
  }

  .hero-stage {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100dvh;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Both the transform and the fade belong to stage two. The custom
       properties are written by script; these defaults are the untouched state
       every fallback path renders in. */
    transform: scale(var(--hero-object-scale, 1));
    opacity: var(--hero-object-opacity, 1);
    will-change: transform, opacity;
  }

  /* The poster is the sequence's last frame, so it is shown at the end of the
     camera push — otherwise it would jump smaller the moment the canvas took
     over. `--hero-zoom` is written by script from the manifest and defaults to
     1, which is also what the no-JS and reduced-motion paths render at. */
  .hero-poster {
    transform: scale(
      calc(var(--hero-zoom, 1) * var(--hero-object-scale, 1))
    );
  }

  /* The canvas is only worth anything once script has drawn something into it.
     Until then it is a transparent rectangle over the poster. */
  .hero-canvas {
    opacity: 0;
  }
  :global(html[data-hero-active]) .hero-canvas[data-ready] {
    opacity: var(--hero-object-opacity, 1);
  }
  /* Dropping the poster once the canvas has something in it saves compositing
     a second full-screen layer. It is an optimisation and not load-bearing: the
     two are the same box at the same object-fit, so the canvas covers the
     poster exactly even where `:has()` is not supported, and both carry
     `--hero-object-opacity` so they fade together in stage three either way. */
  :global(html[data-hero-active]) .hero-poster:has(+ .hero-canvas[data-ready]) {
    opacity: 0;
  }

  .hero-pending {
    display: grid;
    place-items: center;
    gap: 0.5rem;
    width: min(90%, 40rem);
    aspect-ratio: 16 / 10;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    background-color: var(--color-surface);
    color: var(--color-muted);
    text-align: center;
    padding: 1.5rem;
  }

  .hero-title {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-inline: 1.5rem;
    /* Stage three scales it up from a little under full size and stage four
       lifts it out of frame. Both are custom properties so the whole sequence
       is one place to read. */
    transform: translate3d(0, var(--hero-title-y, 0), 0)
      scale(var(--hero-title-scale, 1));
    opacity: var(--hero-title-opacity, 1);
    will-change: transform, opacity;
  }

  /* With script driving, the name starts invisible and arrives on cue. Without
     it, it is simply there — the one line on this screen that must never
     depend on the animation running.

     The object is the mirror case: with script it starts absent and grows in
     behind the title card, without it the poster is simply the picture. */
  :global(html[data-hero-active]) .hero-title {
    --hero-title-opacity: 0;
    --hero-title-scale: 0.72;
  }
  :global(html[data-hero-active]) .hero-stage {
    --hero-object-opacity: 0;
    --hero-object-scale: 0.55;
  }

  .hero-kicker {
    font-size: var(--text-lead);
    line-height: 1.2;
    color: var(--color-muted);
  }

  .hero-name {
    margin-top: 0.35rem;
    /* The one place on the site that reaches past the display role, and it is
       not an arbitrary size: it is the largest the longest name in cv.json can
       be set at without wrapping on a 375px screen, solved by the viewport
       unit rather than by a breakpoint. */
    font-size: clamp(1.75rem, 8.2vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* `.hero-glow` itself is defined once in global.css, beside the other three
     jobs colour is allowed to do. Here it only needs sizing and the same fade
     the object gets, so the two leave together. */
  .hero-glow {
    opacity: var(--hero-object-opacity, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    /* The cue stays — it is still true that there is more below — it just
       stops moving. */
    .hero-scroll-mark {
      animation: none;
    }

    /* Belt and braces. The script already refuses to run, and this makes the
       stylesheet independently correct if it ever stops refusing. */
    .hero,
    :global(html[data-hero-active]) .hero {
      height: auto;
      min-height: 100dvh;
    }
    .hero-media,
    .hero-title,
    .hero-intro {
      transform: none;
      opacity: 1;
      will-change: auto;
    }
    :global(html[data-hero-active]) .hero-title {
      --hero-title-opacity: 1;
      --hero-title-scale: 1;
    }
    :global(html[data-hero-active]) .hero-stage {
      --hero-object-opacity: 1;
      --hero-object-scale: 1;
    }

  }

  /* With nothing driving them, the card and the plate are both at full opacity
     in the middle of one screen — the card absolutely positioned over the
     stage, the plate centred in it — and they overlap. The card is the one that
     goes: the plate is the page's identity and the card is its framing, and a
     static screen only has room to make one of those points. The header is
     carrying the mark and the name at that point anyway, because none of the
     chrome fading applies without script either.

     Keyed on the absence of `data-hero-active` rather than on reduced motion,
     which is the distinction that actually matters: reduced motion is only one
     of the two ways the script ends up not driving, and writing it the other
     way left JavaScript-disabled-but-motion-allowed with both on screen. */
  :global(html:not([data-hero-active])) .hero-intro {
    display: none;
  }
</style>

<script>
  /**
   * Frame scrubber. ~2 KB, no dependencies.
   *
   * GSAP + ScrollTrigger is what the roadmap named, and it is not used here:
   * together they are about 45 KB gzipped against a 50 KB budget for the whole
   * landing page, to replace a division and a `drawImage`. The pin is CSS.
   */
  const root = document.documentElement;
  const section = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const stage = section?.querySelector<HTMLElement>('.hero-stage');
  const title = document.querySelector<HTMLElement>('[data-hero-title]');
  const intro = document.querySelector<HTMLElement>('[data-hero-intro]');

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (section && canvas && stage && title && intro && !reduced.matches) {
    const count = Number(section.dataset.count);
    const widths = (section.dataset.widths ?? '')
      .split(',')
      .map(Number)
      .filter(Boolean)
      .sort((a, b) => a - b);

    // Pick the width once, from the layout viewport rather than from the
    // device pixel ratio: a 3× phone would otherwise pull the desktop set over
    // a mobile connection to fill 400 CSS pixels.
    const width =
      widths.find((w) => w >= window.innerWidth * Math.min(devicePixelRatio, 2)) ??
      widths.at(-1)!;

    const [zoomStart = 1, zoomEnd = 1] = (section.dataset.zoom ?? '')
      .split(',')
      .map(Number)
      .filter((n) => Number.isFinite(n) && n > 0);

    // The poster is the last frame, so it wears the end of the push. Set here
    // rather than in the stylesheet because the value comes from the manifest.
    stage.style.setProperty('--hero-zoom', String(zoomEnd));

    const ctx = canvas.getContext('2d', { alpha: true })!;
    const images: (HTMLImageElement | null)[] = new Array(count).fill(null);
    let loaded = 0;
    let lastDrawn = -1;

    const url = (i: number) => `/hero/w${width}/${String(i).padStart(3, '0')}.webp`;

    /** Nearest frame that has actually arrived, so a fast scroll through a
     *  half-loaded sequence shows the closest thing rather than nothing. */
    function nearest(index: number): HTMLImageElement | null {
      if (images[index]) return images[index];
      for (let d = 1; d < count; d++) {
        if (images[index - d]) return images[index - d];
        if (images[index + d]) return images[index + d];
      }
      return null;
    }

    /**
     * How far down the document the hero would start if it were not pulled up.
     *
     * It has to be measured rather than assumed, because the card's whole
     * arrangement is centred on the stage and the stage has to start at the top
     * of the viewport: anything in the flow above the hero — the sticky header,
     * the dev-only banner, an announcement bar later — moves the title card
     * down by exactly its own height.
     *
     * Self-correcting on a re-run. The margin currently applied is -lift, so
     * `rect.top` is already short by that much and adding it back recovers the
     * same static position whatever the previous value was. Document
     * coordinates, so the scroll position does not enter into it; `.hero`
     * itself is not the sticky element, so its box is always its flow box.
     */
    function lift() {
      const rect = section!.getBoundingClientRect();
      const applied = parseFloat(getComputedStyle(section!).marginTop) || 0;
      const value = rect.top + window.scrollY - applied;
      section!.style.setProperty('--hero-lift', `${value}px`);
    }

    function resize() {
      lift();
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const rect = stage!.getBoundingClientRect();
      canvas!.width = Math.round(rect.width * dpr);
      canvas!.height = Math.round(rect.height * dpr);
      lastDrawn = -1;
    }

    function draw(index: number) {
      const img = nearest(index);
      if (!img) return;
      const cw = canvas!.width;
      const ch = canvas!.height;
      ctx.clearRect(0, 0, cw, ch);
      // `contain`, matching the poster's object-fit, so the two are
      // interchangeable and the swap between them is invisible — times the
      // camera push, which is why the poster carries the end of that push as a
      // CSS transform. Anything that overflows is clipped by the canvas itself,
      // at full source resolution, which is why the push is applied to the draw
      // rather than by scaling the element.
      const t = count > 1 ? index / (count - 1) : 1;
      const zoom = zoomStart + (zoomEnd - zoomStart) * t;
      const scale =
        Math.min(cw / img.naturalWidth, ch / img.naturalHeight) * zoom;
      const w = img.naturalWidth * scale;
      const h = img.naturalHeight * scale;
      ctx.drawImage(img, (cw - w) / 2, (ch - h) / 2, w, h);
      if (!canvas!.dataset.ready) canvas!.dataset.ready = '';
    }

    /** 0 → 1 across the pinned travel. */
    function progress() {
      const rect = section!.getBoundingClientRect();
      const travel = rect.height - window.innerHeight;
      if (travel <= 0) return 0;
      return Math.min(Math.max(-rect.top / travel, 0), 1);
    }

    const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
    /** Normalised position of `p` inside [a, b]. */
    const span = (p: number, a: number, b: number) => clamp01((p - a) / (b - a));

    /**
     * The whole sequence as one map, and it is deliberately symmetrical: the
     * last third runs the first third backwards. The card holds and dissolves
     * while the object grows in behind it; at the far end the object shrinks
     * away while the plate grows in, and the plate leaves upward. Every pair
     * overlaps rather than abutting — a gap between two of these reads as two
     * animations, an overlap reads as one handover.
     *
     *   0.00–0.06  card holds
     *   0.06–0.16  card fades out, shrinking to 0.72
     *   0.12–0.20  object fades in, growing from 0.55
     *   0.16–0.74  frames scrub, 0 → count-1
     *   0.74–0.88  object fades out, shrinking to 0.55
     *   0.78–0.92  plate fades in, growing from 0.72
     *   0.92–1.00  plate fades out and lifts 35vh
     *   0.93–1.00  chrome fades in
     *
     * The frames get 0.58 of 300vh of travel, which is the same ~23px per frame
     * they had over 0.70 of 250vh. That equality is the reason the section is
     * 400vh and not 350: the card's beat is paid for by the section, not by the
     * animation it introduces.
     */
    function render() {
      const p = progress();

      const frame = Math.round(span(p, 0.16, 0.74) * (count - 1));
      if (frame !== lastDrawn) {
        draw(frame);
        lastDrawn = frame;
      }

      const introLeave = span(p, 0.06, 0.16);
      intro!.style.setProperty('--hero-intro-opacity', String(1 - introLeave));
      intro!.style.setProperty('--hero-intro-scale', String(1 - introLeave * 0.28));

      // One expression for both ends of the object's life, so it cannot be
      // present at the start or absent in the middle by getting one of the two
      // ranges wrong: `enter` takes it to full, `recede` takes it back.
      const enter = span(p, 0.12, 0.2);
      const recede = span(p, 0.74, 0.88);
      stage!.style.setProperty('--hero-object-opacity', String(enter * (1 - recede)));
      stage!.style.setProperty(
        '--hero-object-scale',
        String(0.55 + 0.45 * enter - 0.45 * recede),
      );

      const arrive = span(p, 0.78, 0.92);
      const exit = span(p, 0.92, 1);
      title!.style.setProperty('--hero-title-opacity', String(arrive * (1 - exit)));
      title!.style.setProperty('--hero-title-scale', String(0.72 + arrive * 0.28));
      title!.style.setProperty('--hero-title-y', `${exit * -35}vh`);

      // The header arrives last and on its own cue, fading up as the plate
      // leaves, so the interface assembles after the title sequence rather than
      // sitting through it. `data-hero-passed` still flips, because opacity is
      // not enough on its own — the bar also has to stop swallowing clicks and
      // start being reachable, and that is an attribute's job, not a number's.
      const chrome = span(p, 0.93, 1);
      root.style.setProperty('--hero-chrome-opacity', String(chrome));
      root.toggleAttribute('data-hero-passed', chrome > 0.9);
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        render();
        ticking = false;
      });
    }

    /**
     * Load order matters more than load speed. Frame 0 first and alone, so the
     * first thing on screen is correct as early as possible; then a coarse pass
     * over the whole sequence so an early fast scroll lands near something;
     * then everything else. `nearest()` covers the gaps in the meantime.
     */
    function load(index: number): Promise<void> {
      return new Promise((resolve) => {
        const img = new Image();
        img.decoding = 'async';
        img.onload = () => {
          images[index] = img;
          loaded++;
          if (index === lastDrawn || lastDrawn === -1) draw(lastDrawn < 0 ? 0 : lastDrawn);
          resolve();
        };
        img.onerror = () => resolve();
        img.src = url(index);
      });
    }

    async function loadAll() {
      await load(0);
      render();

      const coarse: number[] = [];
      for (let i = 8; i < count; i += 8) coarse.push(i);
      const rest = Array.from({ length: count }, (_, i) => i).filter(
        (i) => i !== 0 && !coarse.includes(i),
      );

      // Six at a time: enough to saturate a connection, few enough that the
      // browser still has sockets left for anything else the page wants.
      const queue = [...coarse, ...rest];
      const workers = Array.from({ length: 6 }, async () => {
        while (queue.length) {
          const next = queue.shift();
          if (next !== undefined) await load(next);
        }
      });
      await Promise.all(workers);
      render();
    }

    root.setAttribute('data-hero-active', '');
    resize();
    void loadAll();

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', () => {
      resize();
      render();
    });

    // If the visitor turns reduced motion on mid-visit, hand the page back.
    //
    // Dropping the attribute is not enough on its own. Every value this script
    // drives is an inline custom property, and inline wins over the stylesheet
    // no matter which attributes are on <html> — so the object and the closing
    // plate would keep whatever opacity the scroll position had left them at,
    // which for anyone who had not reached the end is invisible. Removing the
    // properties is what actually hands them back to the CSS defaults, all of
    // which resolve to the static state.
    reduced.addEventListener('change', (event) => {
      if (!event.matches) return;
      root.removeAttribute('data-hero-active');
      root.setAttribute('data-hero-passed', '');
      root.style.removeProperty('--hero-chrome-opacity');
      for (const [el, props] of [
        [section, ['--hero-lift']],
        [stage, ['--hero-object-opacity', '--hero-object-scale', '--hero-zoom']],
        [title, ['--hero-title-opacity', '--hero-title-scale', '--hero-title-y']],
        [intro, ['--hero-intro-opacity', '--hero-intro-scale']],
      ] as const) {
        for (const prop of props) el.style.removeProperty(prop);
      }
    });
  }
</script>
